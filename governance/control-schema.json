{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "PSW-CONTROL-SCHEMA-v0.2.0",
  "schema_version": "v0.2.0",
  "contract_id": "CONTRACT-v0.2.0",
  "artifact_statuses": [
    "DRAFT",
    "IN_REVIEW",
    "APPROVED",
    "LOCKED",
    "SUPERSEDED",
    "BLOCKED"
  ],
  "notice_statuses": [
    "DRAFT",
    "OPEN",
    "IN_PROGRESS",
    "VERIFIED",
    "CLOSED"
  ],
  "conformance_levels": [
    "STRUCTURAL_CONFORMANCE",
    "TRACEABILITY_CONFORMANCE",
    "HUMAN_REVIEWED",
    "PRODUCTION_READY"
  ],
  "project_stages": [
    "CONCEPT",
    "DEVELOPMENT",
    "OUTLINE",
    "SCRIPT",
    "PREP",
    "PRODUCTION",
    "POST",
    "RELEASE",
    "ARCHIVED"
  ],
  "work_actions": [
    "DISCOVER",
    "BUILD_BIBLE",
    "STRUCTURE",
    "OUTLINE",
    "DRAFT",
    "REVIEW",
    "REWRITE",
    "CONTINUITY_CHECK",
    "BUILD_HANDOFF"
  ],
  "finding_statuses": [
    "OPEN",
    "IN_PROGRESS",
    "FIXED",
    "ACCEPTED_RISK",
    "REGRESSED"
  ],
  "source_statuses": [
    "ACTIVE",
    "PENDING_REVIEW",
    "PARTIALLY_VERIFIED",
    "VERIFIED",
    "DISPUTED",
    "OUTDATED",
    "PAYWALLED",
    "MOVED",
    "ARCHIVED",
    "SUPERSEDED",
    "DO_NOT_USE"
  ],
  "mystery_statuses": [
    "PLANTED",
    "ACTIVE",
    "PARTIALLY_PAID",
    "PAID",
    "DROPPED",
    "REPLACED"
  ],
  "decision_statuses": [
    "ACTIVE",
    "SUPERSEDED",
    "REVISIT",
    "REJECTED"
  ],
  "deprecation_statuses": [
    "OPEN",
    "IN_PROGRESS",
    "VERIFIED",
    "REMOVED"
  ],
  "rights_statuses": [
    "CANDIDATE",
    "INTERNAL_ONLY",
    "RIGHTS_PENDING",
    "LICENSE_REQUESTED",
    "LICENSED_LIMITED",
    "OPEN_LICENSE_VERIFIED",
    "PUBLIC_DOMAIN_CONFIRMED",
    "PROJECT_ORIGINAL",
    "CLIENT_PROVIDED",
    "TALENT_RELEASED",
    "APPROVED_FOR_USE",
    "RESTRICTED",
    "EXPIRING",
    "EXPIRED",
    "DISPUTED",
    "REPLACEMENT_REQUIRED",
    "REMOVED",
    "ARCHIVED",
    "DO_NOT_USE"
  ],
  "upstream_defaults": {
    "PROJECT_MANIFEST": [],
    "SOURCE_REGISTER": ["[[PROJECT-ID]]"],
    "NOTICE_INDEX": ["[[PROJECT-ID]]"],
    "CHANGE_LOG": ["[[PROJECT-ID]]", "[[NOTICE-INDEX-ID]]"],
    "STORY_BIBLE": ["[[PROJECT-ID]]"],
    "OUTLINE": ["[[BIBLE-ID]]"],
    "VERTICAL_EPISODE": ["[[BIBLE-ID]]", "[[SEASON-MAP-ID]]"],
    "SCENE_CARD": ["[[BIBLE-ID]]", "[[OUTLINE-OR-EPISODE-ID]]"],
    "REVIEW": ["[[BIBLE-ID]]", "[[REVIEWED-ARTIFACT-ID]]"],
    "NOTICE": ["[[CHANGED-UPSTREAM-ID]]"],
    "PRODUCTION_HANDOFF": ["[[BIBLE-ID]]", "[[SCRIPT-ID]]", "[[REVIEW-ID]]"],
    "SCRIPT_MASTER": ["[[BIBLE-ID]]", "[[OUTLINE-ID]]"]
  },
  "template_closure": {
    "templates/governance/project-manifest.md": {"kind": "scenario", "scenario": "project-manifest", "artifact_type": "PROJECT_MANIFEST"},
    "templates/governance/source-links.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "SOURCE_REGISTER"},
    "templates/governance/upstream-notices.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "NOTICE_INDEX"},
    "templates/governance/change-log.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "CHANGE_LOG"},
    "templates/story-bible.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "STORY_BIBLE"},
    "templates/episode-outline.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "OUTLINE"},
    "templates/vertical-episode.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "VERTICAL_EPISODE"},
    "templates/scene-card.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "SCENE_CARD"},
    "templates/review-report.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "REVIEW"},
    "templates/notice.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "NOTICE"},
    "templates/production-handoff.md": {"kind": "scenario", "scenario": "draft-artifact", "artifact_type": "PRODUCTION_HANDOFF"},
    "templates/feature-screenplay.fountain": {"kind": "scenario", "scenario": "feature-screenplay", "artifact_type": "SCRIPT_MASTER", "scene_card_policy": "match_script_scenes", "activation": "ACTIVE"},
    "templates/governance/asset-rights-register.md": {"kind": "fragment", "reason": "Project-level blank form copied into an actual rights artifact before use."},
    "templates/governance/third-party-notices.md": {"kind": "fragment", "reason": "Project-level blank form copied into an actual third-party notice artifact before use."}
  },
  "id_prefixes": {
    "PROJECT_MANIFEST": {"prefix": "PROJECT-", "example": "PROJECT-TIDELINE-001"},
    "CONSTRAINT": {"prefix": "CON-", "example": "CON-001"},
    "ASSUMPTION": {"prefix": "ASM-", "example": "ASM-001"},
    "CLAIM": {"prefix": "CLM-", "example": "CLM-001"},
    "SOURCE": {"prefix": "SRC-", "example": "SRC-001"},
    "RIGHTS_ITEM": {"prefix": "RGT-", "example": "RGT-001"},
    "THIRD_PARTY_MATERIAL": {"prefix": "TP-", "example": "TP-001"},
    "STORY_BIBLE": {"prefix": "BIBLE-", "example": "BIBLE-CHAR-001"},
    "CHARACTER_ARC": {"prefix": "ARC-", "example": "ARC-PROTAG-001"},
    "BEAT": {"prefix": "BEAT-", "example": "BEAT-001"},
    "VERTICAL_EPISODE": {"prefix": "EP-", "example": "EP-001"},
    "SCENE_CARD": {"prefix": "SC-", "example": "SC-001"},
    "SCRIPT_MASTER": {"prefix": "SCRIPT-", "example": "SCRIPT-v1.0.0"},
    "ASSET": {"prefix": "ASSET-", "example": "ASSET-PROP-001"},
    "SHOT": {"prefix": "SHOT-", "example": "SHOT-001"},
    "AUDIO": {"prefix": "AUDIO-", "example": "AUDIO-001"},
    "SUBTITLE_UI": {"prefix": "SUB-", "example": "SUB-001"},
    "NOTICE": {"prefix": "NOTICE-", "example": "NOTICE-001"},
    "REVIEW": {"prefix": "REVIEW-", "example": "REVIEW-001"},
    "MIGRATION": {"prefix": "MIG-", "example": "MIG-001"},
    "LOCK": {"prefix": "LOCK-", "example": "LOCK-001"},
    "OUTLINE": {"prefix": "DEL-", "example": "DEL-OUTLINE-001"},
    "SEASON_MAP": {"prefix": "DEL-", "example": "DEL-SEASON-001"},
    "PRODUCTION_HANDOFF": {"prefix": "DEL-", "example": "DEL-HANDOFF-001"}
  },
  "required_fields": {
    "base": [
      "artifact_id",
      "artifact_type",
      "project_id",
      "project_baseline",
      "artifact_version",
      "status",
      "owner",
      "upstream_ids"
    ],
    "by_status": {
      "DRAFT": [],
      "IN_REVIEW": ["review_id", "review_decision", "evidence_refs"],
      "APPROVED": ["reviewer", "approver", "test_run_id", "conformance_level"],
      "LOCKED": ["lock_scope", "content_digest"],
      "SUPERSEDED": ["superseded_by"],
      "BLOCKED": ["blocked_reason"]
    },
    "by_type": {
      "NOTICE": ["notice_status", "affected_ids", "affected_paths", "coupling"],
      "REVIEW": ["findings"],
      "PRODUCTION_HANDOFF": []
    },
    "conditional": [
      {
        "id": "LOCKED_INHERITS_APPROVAL",
        "when": {"status": "LOCKED"},
        "require": ["reviewer", "approver", "test_run_id", "conformance_level", "lock_scope", "content_digest"]
      },
      {
        "id": "PRODUCTION_READY_HANDOFF",
        "when": {"artifact_type": "PRODUCTION_HANDOFF", "conformance_level": "PRODUCTION_READY"},
        "require": ["compatibility_matrix_ref", "rights_register_ref"]
      }
    ]
  },
  "finding_required_fields": [
    "finding_id",
    "severity",
    "evidence_location",
    "failure_mechanism",
    "downstream_impact",
    "minimum_fix",
    "verification_method",
    "owner",
    "status"
  ],
  "finding_acceptance_required_fields": [
    "acceptance_owner",
    "acceptance_until",
    "compensation_plan",
    "reverification_plan"
  ],
  "production_ready": {
    "minimum_project_stage": "PREP",
    "required_handoff_upstream_types": ["STORY_BIBLE", "SCRIPT_MASTER", "REVIEW", "ASSET"],
    "compatibility_record_fence": "compatibility",
    "compatibility_record_id_field": "compatibility_id",
    "allowed_review_decisions": ["RECOMMEND", "PASS"]
  },
  "notice": {
    "coupling_values": ["UPSTREAM", "BASELINE", "SCHEMA", "RIGHTS", "PRODUCTION"],
    "historical_compatibility": {
      "baseline": "active_manifest_baseline",
      "notice_statuses": ["VERIFIED", "CLOSED"],
      "artifact_statuses": ["APPROVED", "LOCKED", "SUPERSEDED"],
      "validation_scope": "base_fields_and_lock_gate_only"
    },
    "constraints": [
      {"notice_status": "DRAFT", "require": []},
      {"notice_status": "OPEN", "require": ["affected_ids", "affected_paths", "coupling"]},
      {"notice_status": "IN_PROGRESS", "require": ["affected_ids", "affected_paths", "coupling", "migration_tasks"]},
      {"notice_status": "VERIFIED", "require": ["affected_ids", "affected_paths", "coupling", "verification_refs", "change_records"]},
      {"notice_status": "CLOSED", "require": ["affected_ids", "affected_paths", "coupling", "verification_refs", "change_records", "closed_by_run_id"]}
    ]
  },
  "ownership": {
    "view": "installation_root_filesystem",
    "match_policy": "excluded_precedes_exactly_one_non_fallback_rule",
    "enforcement": "strict",
    "rules": [
      {
        "id": "OWN-EXCLUDED",
        "patterns": [".git/**", "**/__pycache__/**", ".gitignore"],
        "include_gitignored": true,
        "owner": "excluded",
        "project_validation": false
      },
      {
        "id": "OWN-FIXTURE",
        "patterns": ["tests/*-fixture/**"],
        "owner": "fixture-project:<name>",
        "project_validation": true
      },
      {
        "id": "OWN-TEMPLATE",
        "patterns": ["templates/**"],
        "owner": "template-source",
        "project_validation": false
      },
      {
        "id": "OWN-REFERENCE",
        "patterns": ["examples/**", "references/**"],
        "owner": "repo-source",
        "project_validation": false
      },
      {
        "id": "OWN-TOOLING",
        "patterns": ["scripts/**", "agents/**", ".github/**"],
        "owner": "repo-source",
        "project_validation": false
      },
      {
        "id": "OWN-PACKAGE",
        "patterns": ["SKILL.md", "LICENSE", "LICENSES/**"],
        "owner": "repo-source",
        "project_validation": false
      },
      {
        "id": "OWN-ROOT-PROJECT",
        "patterns": ["governance/**"],
        "owner": "root-project",
        "project_validation": true
      }
    ],
    "fallback": {
      "tracked": "repo-source",
      "untracked": "deny_unless_allowlisted",
      "untracked_error": "UNDECLARED_INSTALL_CONTENT"
    },
    "untracked_allowlist": [],
    "declared_empty_directories": [],
    "reserved_install_names": ["README.md", "CHANGELOG.md", "INSTALLATION_GUIDE.md", "QUICK_REFERENCE.md"],
    "empty_directory_error": "UNDECLARED_EMPTY_DIR",
    "multi_match_error": "MULTI_OWNED_FILE"
  },
  "run_payload": {
    "include": [
      "governance/**",
      "development/**",
      "script/**",
      "production/**",
      "assets/**",
      "archive/**"
    ],
    "exclude": [
      ".git/**",
      "**/__pycache__/**",
      "runs/**",
      "script/exports/**"
    ],
    "managed_extensions": [".md", ".fountain", ".json", ".yaml", ".yml"],
    "untracked_policy": "include_or_block",
    "self_exclusion": "runs/**"
  },
  "export_scope": {
    "source_root": "project_root",
    "selectors": ["project", "season", "episode"],
    "required_artifact_types": {
      "project": ["PROJECT_MANIFEST", "STORY_BIBLE", "SCRIPT_MASTER", "PRODUCTION_HANDOFF"],
      "season": ["PROJECT_MANIFEST", "STORY_BIBLE", "SEASON_MAP", "SCRIPT_MASTER", "PRODUCTION_HANDOFF"],
      "episode": ["PROJECT_MANIFEST", "STORY_BIBLE", "VERTICAL_EPISODE", "SCRIPT_MASTER", "PRODUCTION_HANDOFF"]
    },
    "closure_edge": "upstream_ids",
    "path_mapping": "preserve_relative_posix_path",
    "fixed_exclude": ["runs/**", "development/review-reports/**", "governance/authorizations/**"],
    "reject_source_output_nesting": true,
    "reject_path_escape": true,
    "reject_links": true
  },
  "baseline_impact_selectors": [
    {
      "id": "BASELINE_MATCH",
      "kind": "metadata_equals",
      "field": "project_baseline",
      "value_from": "changed_baseline"
    },
    {
      "id": "CANDIDATE_BASELINE_MATCH",
      "kind": "metadata_equals",
      "field": "candidate_baseline",
      "value_from": "changed_baseline"
    },
    {
      "id": "SCHEMA_SECTION_REF",
      "kind": "metadata_intersects",
      "field": "schema_refs",
      "value_from": "changed_schema_sections"
    }
  ]
}
